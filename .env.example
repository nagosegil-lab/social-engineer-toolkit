# Mobile Trading Bot - Environment Configuration
# העתק קובץ זה ל-.env ועדכן את הערכים

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# MT5 Connection Settings
# חשוב: לעולם אל תחלוק את הפרטים האלה!
MT5_LOGIN=12345678
MT5_PASSWORD=your_password_here
MT5_SERVER=your_broker_server_name
MT5_PATH=/path/to/mt5/terminal64.exe

# AI/ML Settings
AI_MODEL_PATH=./models
USE_AI=True
AI_CONFIDENCE_THRESHOLD=0.7

# Trading Settings
DEFAULT_LOT_SIZE=0.01
MAX_LOT_SIZE=1.0
STOP_LOSS_PIPS=50
TAKE_PROFIT_PIPS=100
RISK_PERCENTAGE=1.0

# Database
DATABASE_URL=sqlite:///./trading_bot.db

# Security (שנה את זה בייצור!)
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

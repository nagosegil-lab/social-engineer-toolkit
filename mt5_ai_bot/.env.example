# Connector: mt5 or metaapi
CONNECTOR=mt5

# Trading instrument and timeframe
SYMBOL=EURUSD
TIMEFRAME=M5

# Order sizing and risk
LOT=0.10
RISK_PER_TRADE=0.0

# Trading controls
TRADE_MODE=paper  # live | paper
MAX_TRADES_PER_DAY=20
MAX_DAILY_LOSS=0.0
MAX_EXPOSURE_LOTS=0.0
TRADING_HOURS=08:00-22:00
TIMEZONE=UTC

# Optional stops in points (e.g., 100 = 10 pips on 5-digit pairs)
SL_POINTS=100
TP_POINTS=100
SLIPPAGE=20

# MT5 (VPS/Windows with terminal installed)
MT5_LOGIN=12345678
MT5_PASSWORD=changeme
MT5_SERVER=YourBroker-Server

# MetaApi (Cloud)
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Model path (Joblib). Leave default if unsure
MODEL_PATH=/workspace/mt5_ai_bot/models/model.joblib
